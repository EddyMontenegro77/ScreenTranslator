<Window x:Class="ScreenTranslator.Views.StatusIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">
	
        <Grid>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,30,30">

                <TextBlock x:Name="TxtStatus"
                           Margin="0,0,0,8"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Procesando..." />

                <ProgressBar x:Name="ProgressTranslate"
                             Width="200"
                             Height="25"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>

            </StackPanel>

        </Grid>
</Window>