<Window x:Class="ScreenTranslator.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation Log"
        Width="700" Height="400">
    <DataGrid ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
        <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
            <DataGridTextColumn Header="Detected Text" Binding="{Binding DetectedText}" Width="*"/>
            <DataGridTextColumn Header="Translation" Binding="{Binding Translation}" Width="*"/>

            <DataGridTemplateColumn Header="Copy" Width="140">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Original"
                                    Margin="2"
                                    Tag="{Binding DetectedText}"
                                    Click="CopyOriginal_Click"/>
                            <Button Content="Translation"
                                    Margin="2"
                                    Tag="{Binding Translation}"
                                    Click="CopyTranslation_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</Window>