<Window x:Class="ScreenTranslator.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation Log"
        Style="{StaticResource MainWindowStyle}"
        Width="700" Height="400">

    <Window.Resources>
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <DataGrid ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
        <DataGrid.Columns>
            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
            <DataGridTextColumn Header="Detected Text" Binding="{Binding DetectedText}" Width="*"/>
            <DataGridTextColumn Header="Translation" Binding="{Binding Translation}" Width="*"/>

            <DataGridTemplateColumn Header="Copy" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Original"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Tag="{Binding DetectedText}"
                                    Click="CopyOriginal_Click"/>
                            <Button Content="Translation"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Tag="{Binding Translation}"
                                    Click="CopyTranslation_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</Window>