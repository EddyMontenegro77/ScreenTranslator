<Window x:Class="ScreenTranslator.Views.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloading model..." Height="150" Width="420"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Text="Starting download..." Margin="0,0,0,10"/>
        <ProgressBar x:Name="DownloadProgressBar" Grid.Row="1" Height="20" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="PercentText" Grid.Row="2" Text="0%" Margin="0,8,0,0" HorizontalAlignment="Right"/>
    </Grid>
</Window>