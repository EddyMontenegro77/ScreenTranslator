<Window x:Class="ScreenTranslator.Views.ModelSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración inicial" Height="260" Width="420"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="No translation model was found installed."
                   TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Choose which model to install:" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2">
            <RadioButton x:Name="LightModelRadio" GroupName="ModelChoice" IsChecked="True"
                         Content="qwen3.5:4b — lighter, faster" Margin="0,4"/>
            <RadioButton x:Name="HeavyModelRadio" GroupName="ModelChoice"
                         Content="qwen3.5:9b — heavier, better translation quality" Margin="0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="I'll download it myself on Ollama" Click="ManualSetup_Click" Margin="0,0,10,0" Padding="8,4"/>
            <Button Content="Download" Click="Download_Click" Padding="20,4" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>