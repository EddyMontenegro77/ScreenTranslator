<Application x:Class="ScreenTranslator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScreenTranslator"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <tb:TaskbarIcon
            x:Key="TrayIcon"
            IconSource="/ScreenTranslator;component/Assets/niholator.ico"
            ToolTipText="ScreenTranslator"
            TrayMouseDoubleClick="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="TrayIcon_LeftClick"/>
                    <MenuItem Header="Exit" Click="TrayIcon_Exit"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
