<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenTranslator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    
    <Grid>
        <TextBlock Text="ScreenTranslator" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="24"/>
        <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="0,0,0,10">

            <Button Content="Capture"
                Width="200"
                Height="60"
                FontSize="24"
                Margin="0,0,0,10"
                Click="BtnCapture_Click"/>

            <Button Content="Settings"
                Width="200"
                Height="40"
                FontSize="20"
                Margin="0,0,0,5"
                Click="Settings_Click"/>
            
            <Button Content="Log"
                    Width="200"
                    Height="40"
                    FontSize="20"
                    Margin="0,0,0,5"
                    Click="Log_Click"/>
            <Button Content="How to Use"
                    Width="200"
                    Height="40"
                    FontSize="20"
                    Margin="0,0,0,5"
                    Click="HowToUse_Click"/>

        </StackPanel>
    </Grid>
</Window>
