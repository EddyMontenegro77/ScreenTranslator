        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenTranslator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="ScreenTranslator" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="24"/>
        <Button Content="Capture" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="60" FontSize="24" Click="BtnCapture_Click"/>
    </Grid>
</Window>
