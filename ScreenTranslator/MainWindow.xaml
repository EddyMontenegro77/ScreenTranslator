<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenTranslator"
        mc:Ignorable="d"
        Style="{StaticResource MainWindowStyle}"
        Title="ScreenTranslator"
        Height="520"
        Width="420"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Header -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,35,0,20">

            <TextBlock Text="Niholator"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Translate text directly from your screen"
                       FontSize="14"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

        </StackPanel>



        <!-- Main Actions -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="240">


            <Button Content="Capture"
                    Background="{StaticResource DangerColor}"
                    Height="65"
                    FontSize="24"
                    Margin="0,0,0,15"
                    Click="BtnCapture_Click"/>


            <Button Content="Settings"
                    Height="45"
                    FontSize="18"
                    Margin="0,0,0,10"
                    Click="Settings_Click"/>


            <Button Content="Translation Log"
                    Height="45"
                    FontSize="18"
                    Margin="0,0,0,10"
                    Click="Log_Click"/>


            <Button Content="How to Use"
                    Height="45"
                    FontSize="18"
                    Click="HowToUse_Click"/>

        </StackPanel>



        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="Ctrl + Shift + T  •  Screen capture shortcut"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   FontSize="12"
                   Opacity="0.6"/>


    </Grid>

</Window>